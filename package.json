{
  "name": "dti-gestao",
  "version": "1.0.0",
  "description": "DTI Gestao - inventario e monitoramento de equipamentos de rede do HMACN",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "voip-scan": "src/index.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "scan": "node src/index.js scan",
    "enrich": "node src/index.js enrich",
    "monitor": "node src/index.js enrich --monitor",
    "ramais": "node src/index.js ramais",
    "web": "node src/index.js web",
    "report": "node src/index.js report",
    "export": "node src/index.js export",
    "server": "node scripts/supervisor.mjs",
    "bench": "node scripts/bench.mjs",
    "rebuild-stats": "node scripts/rebuild-stats.mjs",
    "smoke": "node scripts/smoke.mjs",
    "semear-admin": "node scripts/semear-admin.mjs",
    "migrar-locais": "node scripts/migrar-locais.mjs",
    "coletar-impressoras": "node scripts/coletar-impressoras.mjs",
    "importar-impressoras": "node scripts/importar-impressoras.mjs",
    "gerar-certificado": "node scripts/gerar-certificado.mjs"
  },
  "keywords": [
    "voip",
    "sip",
    "scanner",
    "network",
    "inventory",
    "monitoring",
    "alcatel",
    "alcatel-lucent-enterprise",
    "sqlite"
  ],
  "author": "Thiago Possa",
  "license": "MIT",
  "dependencies": {
    "ldapjs": "^3.0.7",
    "net-snmp": "^3.29.3"
  },
  "files": [
    "src",
    "scripts",
    "start-server.cmd",
    "web-config.example.json",
    "README.md"
  ]
}
