# Active Directory — Monitor VoIP
# Copie para .env e preencha. O .env NAO e versionado.

# Controladores de dominio (separados por espaco ou virgula).
# Com varios, o ldapjs faz failover automatico quando um falha.
AD_URL=ldap://dc1.rede.sp ldap://dc2.rede.sp

AD_BASE_DN=DC=rede,DC=sp
AD_DOMAIN=rede.sp

# Conta usada APENAS para buscar usuarios na tela de cadastro (somente leitura).
# O login do usuario final nunca usa estas credenciais: ele faz bind com a
# propria senha digitada, e a senha nao e gravada em lugar nenhum.
AD_SEARCH_USER=
AD_SEARCH_PASSWORD=

# Tempo maximo de cada operacao LDAP (ms)
AD_TIMEOUT_MS=8000
